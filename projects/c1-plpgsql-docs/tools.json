[
  {
    "type": "function",
    "function": {
      "name": "parse_procedure",
      "description": "Разобрать одну процедуру или функцию plpgsql. Вернуть факты кода и комментарии, приклеенные по номеру строки.",
      "parameters": {
        "type": "object",
        "properties": {
          "sql": {
            "type": "string",
            "description": "Текст файла с одной процедурой или функцией plpgsql."
          }
        },
        "required": [
          "sql"
        ],
        "additionalProperties": false
      }
    },
    "output": {
      "type": "object",
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "error": {
          "type": "string",
          "enum": [
            "not_one_routine",
            "parse_error"
          ]
        },
        "routine": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "procedure",
                "function"
              ]
            },
            "name": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "name"
          ]
        },
        "facts": {
          "type": "object",
          "properties": {
            "parameters": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/fact"
              }
            },
            "objects": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/fact"
              }
            },
            "statuses": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/fact"
              }
            },
            "calls": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/fact"
              }
            },
            "checks": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/fact"
              }
            },
            "orderings": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/fact"
              }
            },
            "comments": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/fact"
              }
            }
          },
          "required": [
            "parameters",
            "objects",
            "statuses",
            "calls",
            "checks",
            "orderings",
            "comments"
          ]
        }
      },
      "required": [
        "ok"
      ]
    },
    "$defs": {
      "fact": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "parameter",
              "object",
              "status",
              "call",
              "check",
              "ordering",
              "comment"
            ]
          },
          "name": {
            "type": "string"
          },
          "line": {
            "type": "integer"
          },
          "near_id": {
            "type": "string"
          },
          "value": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "columns": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "actions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "defined_here": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "kind"
        ],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "check_schema",
      "description": "Сверить вызовы и таблицы текущего разбора с data/schema.sql. Вернуть зависимости, которых в схеме нет.",
      "parameters": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
