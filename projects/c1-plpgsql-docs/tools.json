            },
            "required": [
              "id",
              "title",
              "facts",
              "text"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "ok"
      ]
    },
    "$defs": {
      "fact": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "parameter",
              "object",
              "status",
              "call",
              "check",
              "ordering",
              "comment"
            ]
          },
          "name": {
            "type": "string"
          },
          "line": {
            "type": "integer"
          },
          "near_id": {
            "type": "string"
          },
          "value": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "columns": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "actions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "defined_here": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "kind"
        ],
        "additionalProperties": false
      }
    }
