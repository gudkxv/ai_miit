  {
    "type": "function",
    "function": {
      "name": "write_sections",
      "description": "Записать фразы разделов в report.json по id.",
      "parameters": {
        "type": "object",
        "properties": {
          "sections": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "description": "id раздела из fill_template."
                },
                "text": {
                  "type": "string",
                  "description": "Фраза раздела. Пустая строка, если фактов нет."
                }
              },
              "required": [
                "id",
                "text"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "sections"
        ],
        "additionalProperties": false
      }
    },
    "output": {
      "type": "object",
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "error": {
          "type": "string",
          "enum": [
            "no_report"
          ]
        },
        "written": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "missing": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "ok",
        "written",
        "missing"
      ]
    }
  },
